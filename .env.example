# Required only for the model funnel (stages 1-3). Discovery + the gate run without it.
ANTHROPIC_API_KEY=sk-ant-...

# Per-connector submission credentials. A connector without its credential
# degrades to export-only; it never silently falls back to another route.
GREENHOUSE_API_KEY=
LEVER_API_KEY=
ASHBY_API_KEY=
WORKABLE_API_KEY=
SMARTRECRUITERS_API_KEY=

# Set to 1 to serve every connector from fixtures/ instead of the network.
SOURCING_OFFLINE=0
